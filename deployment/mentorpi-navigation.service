[Unit]
Description=MentorPi learned navigation (starts disarmed)
Requires=docker.service
After=docker.service wifi.service start_node.service
Conflicts=start_node.service wifi.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/docker/tmp/mentorpi_nav
ExecStartPre=/usr/bin/docker start MentorPi
ExecStartPre=+/usr/bin/python3 -m mentorpi_nav.robot.service preflight
ExecStart=/usr/bin/docker exec -u ubuntu -e PYTHONPATH=/home/ubuntu/shared/mentorpi_nav -w /home/ubuntu/shared/mentorpi_nav MentorPi /bin/zsh -c "source /home/ubuntu/.zshrc >/dev/null; exec ros2 launch deployment/navigation.launch.py"
ExecStop=/usr/bin/python3 -m mentorpi_nav.robot.service stop
ExecStopPost=/usr/bin/docker exec -u ubuntu -w /home/ubuntu/shared/mentorpi_nav MentorPi /bin/zsh -c "source /home/ubuntu/.zshrc >/dev/null; python3 -m mentorpi_nav.robot.stop_motors"
Restart=always
RestartSec=3
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
